{
  "skill_name": "1.1 Outline_Generator",
  "version": "7.0.1",
  "description": "科研流水线步骤 1.1：基于结构化协议与高度自主发散推演的学术大纲生成器。支持全局路径动态注入，内置顶尖学术审稿人发散引擎。",
  "dependencies": [],
  "dynamic_variables_required": {
    "research_topic": "用户输入的研究主题，例如：电力市场",
    "root_path": "用户在对话中动态传入的项目绝对根路径，例如由用户输入的：/Users/scottsun/Documents/Obsidian Vault/研究课题/电力市场",
    "has_complete_data": "用户是否拥有完整数据的布尔标识 ('true' / 'false')"
  },
  "static_slots": {
    "output_path": "{{root_path}}/第1步：讨论框架/研究框架_文字版.md"
  },
  "agent_autonomy_directive": {
    "role_positioning": "你作为顶尖学术顾问与资深评审，请直接根据给定的 {{research_topic}}，充分调用你的计量经济学、量化金融学及相关能源/商品 market 知识库，自主发散并高密度填充本课题的专业内核。你必须在生成各章节段落时，独立、主动完成以下推演，严禁向用户索要任何前置参数或输出解释性废话。",
    "core_deduction_steps": {
      "1_背景挖掘": "自主推理该 {{research_topic}} 主题涉及的产业链微观特征、宏观冲击、制度背景及核心现实痛点，利用强逻辑链引出合理的微观/宏观机制冲突，作为第一章的宏观叙事基石。",
      "2_方法匹配": "根据 has_complete_data 的值执行双轨建模：【IF has_complete_data == 'true'】➔ 智能体必须绝对限缩、严禁自行幻想或推荐外部未知数据源。必须通过扫描已存在于工作区『模型数据』文件夹下的真实数据字典（物理列名），只基于这些已有数据和变量频度，构建对应的回归方程或算法设计，只对已有数据开展大纲说明；【IF has_complete_data == 'false'】➔ 允许充分发挥学术直觉，自主发散推荐最适合该场景的前沿计量模型，并明确指引用户后续去特定数据库抓取哪些指标资产。",
      "3_目标推演": "基于你匹配的方法论与经济学直觉，自主推演、预测出一套高度合理的预期量化特征、市场运行状态分类或因果反馈规律，作为实证分析的预期刚性靶点，填入第三章。",
      "4_智库落脚点": "强行转入一线智库与核心监管层视角，自主发散出 3 条针对该主题的、具有极强可操作性的硬核政策建议，涵盖微观行为引导、交易所风险控制工具箱优化、宏观生态培育等维度，作为第四章收尾。"
    }
  },
  "academic_tone_protocols": {
    "style_requirement": "各章节正文必须且只能是标准学术公文体（课题申报书、顶刊引言风格）的连续大段落。全段必须依靠学术过渡词（如‘具体而言’、‘有鉴于此’、‘基于此’）自然串联逻辑，消除所有口语化痕迹。",
    "prohibited_formats": "全案必须严格输出为标准的 Markdown。严禁出现任何无序/有序列表（如 *、-、1. 等），严禁自行追加或泛滥衍生下级小标题（如 ###）。"
  },
  "chapter_content_protocols": {
    "global_constraint": "全篇第一行必须、且只能强制物理生成 `# {{research_topic}}` 作为全局主标题。其下依次生成以下四个预设模块，且只能使用 `## ` 作为模块标题前缀。",
    "一、研究背景与主要研究内容": {
      "format_rule": "必须物理生成 `## 一、研究背景与主要研究内容` 标题，下方紧接单一大段落。",
      "source_logic": "联动执行 agent_autonomy_directive.core_deduction_steps.1_背景挖掘。采用高度严谨、连续的学术段落，深度论述该领域的微观/宏观现实矛盾，以连贯的学术长句引出核心研究问题与机制路径。"
    },
    "二、研究方法及数据来源": {
      "format_rule": "## 二、研究方法及数据来源",
      "source_logic": "联动执行 agent_autonomy_directive.core_deduction_steps.2_方法匹配。以严谨的申报书语体撰写成段。阐述拟构建的核心计量模型及其内在数理逻辑，并在同一段落内直接明确界定所需的数据特征及相关数据库来源，一气呵成写完连续大段落。"
    },
    "三、实证分析与预期目标": {
      "format_rule": "## 三、实证分析与预期目标",
      "source_logic": "联动执行 agent_autonomy_directive.core_deduction_steps.3_目标推演。连贯叙述实证推进脉络。段落后半部须明确收敛至预期的核心学术假设或因果反馈规律，为后续实证双向比对提供刚性死锁靶点。"
    },
    "四、结论及建议": {
      "format_rule": "## 四、结论及建议",
      "source_logic": "联动执行 agent_autonomy_directive.core_deduction_steps.4_智库落脚点。采用一个不间断的宏观大段落横向写到底。段落内部依次、物理使用‘一是...；二是...；三是...’的句式进行硬切分与无缝链接，串联具有一线监管实操性的微观、中观与宏观生态建议。"
    }
  },
  "execution_pipeline": {
    "step_1": "【实时变量抓取与注入】在运行时严格捕获外部智能体解析到的全局变量 {{root_path}} 和 {{research_topic}}，并原地对 static_slots.output_path 进行纯字符串替换拼接，严禁在未拼接状态下写入任何物理存储。",
    "step_2": "【主标题生成】首行直接强制物理输出 `# {{research_topic}}` 并留空一行。",
    "step_3": "【独立推演总装】依次遍历 `chapter_content_protocols` 中的四大模块。在生成每个模块时，必须强制激活 `agent_autonomy_directive` 中对应的推演逻辑，结合 `academic_tone_protocols` 刚性限制，生成纯文本、无列表的高密度连续大段落。",
    "step_4": "【覆写输出】根据第一步动态生成的绝对路径，自动创建上级目录（若不存在），然后将完美格式排版后的最终总装文本写入并覆写文件。"
  }
}