{
  "skill_name": "4.1 Academic_Paper_Generator",
  "version": "5.12.0",
  "description": "科研/智库研究报告多源数据内容全自动总装、字数精控与学术话语清洗通用流水线技能（解耦版）",
  "dependencies": [
    "4.2 Format_Standard.skill"
  ],
  "dynamic_variables_required": {
    "research_topic": "运行时注入的研究主题，由大流水线动态赋能（如：基差与泡沫）",
    "research_topic_en": "运行时注入的英文简称，用于路径拼接（如：Cotton / Electricity_Market）",
    "root_path": "运行时注入的项目绝对根路径（如：/Users/username/Documents/Project）",
    "code_and_images_path": "运行代码与保存实证结果的专属生产区路径"
  },
  "static_slots": {
    "slot_1_blueprint": "{{root_path}}/第1步：讨论框架/研究框架_理论版.md",
    "slot_2_literature_review": "{{root_path}}/第2步：参考文献/文献综述.md",
    "slot_3_math_model": "{{root_path}}/第3步：实证分析/建模.md",
    "slot_4_empirical_results": "{{root_path}}/第3步：实证分析/模型结果.md",
    "image_path": "{{code_and_images_path}}/images/",
    "output_path": "{{root_path}}/第4步：写成论文/论文全文.md"
  },
  "academic_tone_protocols": {
    "style_requirement": "全文必须严格遵循顶级计量经济学与量化金融学期刊（如《经济研究》、《金融研究》）的学术公文口吻。叙述必须保持绝对客观、理性的第三人称叙述，严禁流露个人情绪或使用修辞性夸张。",
    "prohibited_expressions": [
      "严禁使用任何具有戏剧化、小说式或情绪化色彩的非学术词汇，包括但不限于：‘史诗级’、‘骇人听闻’、‘血淋淋’、‘无脑跟风’、‘脱缰的野马’、‘惨遭清场’、‘斗兽博弈场’、‘雷霆手段’、‘壮士断腕’、‘令人窒息’、‘癫狂’、‘无脑’等。",
      "严禁将市场或资金拟人化，禁止使用文学化修饰语。"
    ],
    "mandatory_terminology_mapping": {
      "资金极度疯狂/放水": "流动性极度充裕/系统性流动性冲击",
      "价格暴涨暴跌/狂热": "资产价格的非线性投机性偏离/结构性突变",
      "市场很不正常/失灵": "市场微观结构扭曲/适应性效率下降/弱式有效性间歇性丧失",
      "现货企业被洗出局/被割韭菜": "理性产业套保资金规模因追加保证金压力而发生非自愿性缩减",
      "投机资金博弈厮杀": "非基本面噪声交易者密集的指令流博弈与动量策略共振",
      "价格回归的弹簧断了": "理性套利边界失效与期现货价格收敛机制受阻"
    }
  },
  "chapter_word_budgets": {
    "global_constraint": "全篇总装字数必须总体保持在 5000 至 7000 字之间。除摘要与引言执行刚性锁定外，其余各章节字数转为弹性预算，由 Agent 根据数据丰满度自适应伸缩。",
    "标题模块": {
      "rule": "论文全本的题目必须完全、一字不差地物理采用并继承 [slot_1_blueprint] 中首行定义的 `# {{research_topic}}` 主标题文本。Agent 在总装输出时，绝对严禁擅自增减字句、外推演绎或添加任何额外的副标题与方法论修饰词。"
    },
    "摘要与关键词": {
      "budget": "250-300字（刚性死锁）",
      "source_logic": "【全局延迟依赖项】此模块必须在第一阶段正文完全组装后执行。Agent 必须明确判定本文是一篇具有完整实证和数据支撑的定量学术论文。摘要须高拟真提炼并对齐后文正文，且必须饱含核心实证数据（明确指出关键参数、极值、p值或跳跃幅度等具体数据事实），严禁流于空洞。依照 academic_tone_protocols 进行学术词汇脱水，确保逻辑闭环。"
    },
    "引言模块": {
      "budget": "280-320字（刚性死锁）",
      "source_logic": "作为全文导论段落，不加一二级标题，直接置于摘要下方、文献梳理之前。必须严格遵循‘三步走’学术引言范式：首先，结合 [slot_1_blueprint] 核心变量（如 {{research_topic}}）作为连接现货与衍生品市场的核心功能，点明其对实体经济基本面或企业市值管理的关键纽带作用；其次，揭示当前学术界对该变量的经济后果研究盲区；最后，明确指出本文选取特定样本，综合运用前沿计量模型进行深度实证，为交易所风险管理提供智库参考。"
    },
    "一、文献梳理和主要研究内容": {
      "budget": "弹性预算（跟随输入源动态无损平铺）",
      "source_logic": "完全无损物理复制继承 [slot_2_literature_review] 文件中的全部文献综述正文。"
    },
    "二、计量模型构建与原理": {
      "budget": "弹性预算（跟随输入源动态无损平铺）",
      "source_logic": "完全、无损、原汁原味地物理继承 [slot_3_math_model] 中的全部数学公式、状态空间方程与数理推导过程。严禁对核心方程进行简化。模型中出现的每一个计量符号，其下方必须强制使用【Markdown 无序列表或极简两栏对照】进行中文物理注释与经济学含义解释，严禁揉杂成大段文本段落。"
    },
    "三、实证结果分析": {
      "budget": "弹性预算（跟随输入源动态无损平铺）",
      "source_logic": "全面、完整地读取并继承 [slot_4_empirical_results] 中的全部段落推导、系数解读和标准三线表。必须做到每一层分类维度在最终论文里都有扎实的、完整的映射论述。配合 [image_path] 路径下的图片进行原生嵌入，引用图片方括号 `![纯净中文标题]` 内绝对拦截所有 `$` 符号与下划线 `_`，防止 Obsidian 渲染崩溃。"
    },
    "四、主要结论与相关建议": {
      "budget": "根据全局字数弹性浮动（约800-1000字）",
      "source_logic": "【前半部分（双向比对死锁逻辑）】物理读取 [slot_1_blueprint] 中的“特征断言与分析关卡”，将其与 [slot_4_empirical_results] 中实际跑出的真实数据进行交叉校验。若实际实证结果与预期结论存在出入，严格禁止削足适履，必须 100% 尊重并以真实的实证数据结果为准进行客观陈述与事实收敛。【后半部分（相关建议）】强行转入硬核的一线监管智库视角。⚠️刚性排版与句式协议：绝对禁止任何换行、分行、项目符号或数字序号，整段建议必须完全采用‘一个连贯的、不间断的宏观大段落’横向写到底。在段落内部，必须强制、依次、物理使用‘一是结合本文实证发现锚定【微观行为治理与信息披露维度】……；二是针对本文发掘的波动特征切入【交易所自身风控工具箱与机制优化维度】……；三是落地于【市场生态培育与精准服务体系维度】……’的句式进行逻辑切分与无缝链接。"
    },
    "物理入栈参考文献": {
      "source_logic": "完全、无损、原汁原味地物理复制并继承 [slot_2_literature_review] 文件中第三个区块对应的所有文献列表，确保内部全部使用半角标点，且与正文引用序号物理映射一致。"
    }
  },
  "execution_pipeline": {
    "step_1": "【Stage 1: 正文骨架全要素合成】动态拼接 {{root_path}} 路径。首先屏蔽‘摘要与关键词’模块。严格按照各章节的字数预算、来源逻辑以及 academic_tone_protocols 的学术清洗协议，完全组装出由题目、引言、一、二、三、四章及参考文献构成的论文核心骨架全文本。",
    "step_2": "【Stage 2: 全文逆向提炼摘要】将 step_1 已经生成的论文骨架全文本整体作为输入流喂给 Agent。Agent 深度通读全文后，严格根据‘摘要与关键词’的刚性字数限制（250-300字），提炼出饱含核心实证真实数据的脱水摘要与关键词，并物理逆向插入、缝合至主标题下方、引言模块上方。",
    "step_3": "【Stage 3: 格式洗牌与终极输出】将缝合摘要后的论文全文整体作为流输入，立刻自动、物理联动运行 dependencies 中挂载的 Format_Standard.skill 技能，一键完成一二级标题序号校准、首个图表‘下同’去噪、以及文末参考文献向极简 [J] 格式的终极洗牌。全面净化元语境痕迹，最终将完美格式排版后的总装文本，覆盖写入到指定的目标 output_path 路径下。"
  },
  "guardrails": {
    "latex_render": "严格禁止 ```latex 代码块。独立公式用 $$\\dots$$，行内变量用 $ \\dots $。",
    "content_integrity": "严禁在最终总装文本中出现任何关于系统插槽、提示词规则、大流水线运行痕迹等元语境思考词汇。"
  }
}