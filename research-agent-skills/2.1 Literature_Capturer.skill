{
  "skill_name": "2.1 Literature_Capturer",
  "version": "1.0.0",
  "description": "科研流水线步骤 2.1：硬核文献地毯式捕获专家（依托 gpt-researcher 与 Python 环境）。支持全局路径动态注入，负责全网检索并物理下载 PDF 至本地参考文献区，同时建立 JSON 存证索引。",
  "dependencies": [],
  "dynamic_variables_required": {
    "research_topic": "系统运行时动态注入的项目研究主题",
    "root_path": "系统运行时动态注入的项目绝对根路径"
  },
  "static_slots": {
    "pdf_download_directory": "{{root_path}}/第2步：参考文献/",
    "index_manifest_file": "{{root_path}}/第2步：参考文献/download_manifest.json"
  },
  "execution_rules": {
    "role_positioning": "你目前正处于智库/学术全自动流水线的文献捕获节点。请扮演全网地毯式学术检索专家，根据给定的研究主题和时间、质量约束，执行物理级下载与存证动作。",
    "autonomous_search_protocol": {
      "search_engine": "启动 gpt-researcher 核心引擎，调用多维度、脱水后的英文学术检索词进行地毯式检索。",
      "data_source_priority": [
        "arXiv",
        "Semantic Scholar",
        "SSRN",
        "Google Scholar",
        "ScienceDirect",
        "Wiley",
        "Springer"
      ],
      "time_horizon_constraint": "2020年至今（硬性时间窗口过滤）",
      "target_count": 10
    },
    "physical_download_protocol": {
      "filter_criteria": "主动排除新闻、网页快照、非学术简报与低水平博客。基于计量模型公式的硬核度、特定实证方法的创新度以及与主题 {{research_topic}} 的高相关度进行筛选。",
      "download_action": "激活本地 Python 环境（联合调用 requests、wget 或 arxiv 库等底层工具），绕过防爬壁垒，将精选出的 10 篇核心论文的 PDF 全文物理下载并落地存储至 pdf_download_directory 路径下。"
    },
    "index_manifest_guardrail": {
      "action": "在下载动作完成后，立刻在同级目录下自动物理生成或更新 download_manifest.json 索引文件。",
      "json_format_strict": "严禁生成大段解释，该 JSON 内部必须且只能包含一个标准化数组，严格记录每一个物理落地文件的：『本地文件名 (file_name)』与『文献原始标题 (original_title)』。"
    }
  },
  "output_control": {
    "terminal_feedback": "任务执行完毕后，请在终端或对话界面直接打印输出已成功下载并物理落地的文献列表，格式为：[序号] 本地文件名 —— 原始标题。严禁带有前言后记。"
  }
}