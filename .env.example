# ==============================================================================
# Research Agent Environment Configuration Template
# 复制本文件并重命名为 .env，然后填入你自己的 API Key
# ==============================================================================

# 1. 搜索引擎配置（用于文献抓取与事实核查，推荐 Tavily）
TAVILY_API_KEY=your_tavily_api_key_here

# 2. 核心大语言模型（LLM）配置（默认支持智谱 GLM 或任意 OpenAI 兼容接口）
OPENAI_API_KEY=your_openai_or_zhipu_api_key_here
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# 推荐模型选型
SMART_LLM=openai:glm-4-flash
FAST_LLM=openai:glm-4-flash

# 向量嵌入模型
EMBEDDING_MODEL=openai:embedding-2

# 3. 报告与文献综述语言
REPORT_LANGUAGE=Chinese
